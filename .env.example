# Copia a .env.local en desarrollo. En Vercel: Project → Settings → Environment Variables.

# Supabase (público en cliente)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Servidor únicamente (nunca exponer al cliente)
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (producción: https://tu-dominio o URL de Vercel)
NEXT_PUBLIC_APP_URL=https://aeromatch.eu

# Emails (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
WELCOME_EMAIL_FROM=
WELCOME_EMAIL_WEBHOOK_SECRET=

# Admin
ADMIN_EMAILS=admin@example.com

# Cron (Vercel Cron → /api/cron/job-requests)
CRON_SECRET=

# Billing (Paddle) — si usáis checkout
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# Otros
NEXT_PUBLIC_BETA_ALL_PREMIUM=false
NEXT_PUBLIC_FOUNDING_CUTOFF_DATE=2026-01-20
